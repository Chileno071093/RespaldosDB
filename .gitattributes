# Texto normalizado a LF en el repositorio y CRLF en la copia de trabajo (proyecto solo para Windows).
* text=auto eol=crlf

*.vb        text eol=crlf
*.vbproj    text eol=crlf
*.sln       text eol=crlf
*.resx      text eol=crlf
*.config    text eol=crlf
*.md        text eol=crlf
*.ps1       text eol=crlf
*.sql       text eol=crlf
.gitignore  text eol=crlf
.gitattributes text eol=crlf

# Binarios
*.png  binary
*.jpg  binary
*.ico  binary
*.exe  binary
*.dll  binary
*.pdb  binary
